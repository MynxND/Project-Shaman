{
  "name": "project-shaman",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @shaman/shared test && pnpm --filter @shaman/client test:network && pnpm --filter @shaman/client test:npc && pnpm --filter @shaman/client test:skill && pnpm --filter @shaman/client test:zone && pnpm --filter @shaman/client test:equipment",
    "rig:convert": "node tools/rig/ssr-convert.mjs",
    "rig:validate": "node tools/rig/ssr-validate.mjs",
    "test:weapon-actions": "node tools/rig/test_weapon_attack_03.mjs",
    "test:ops": "pnpm --filter @shaman/server build && node apps/client/scripts/ops-test.mjs",
    "build:prod": "node tools/ops/with-env.mjs pnpm build",
    "start:server": "node tools/ops/with-env.mjs node apps/server/dist/index.js",
    "start:client": "node tools/ops/with-env.mjs pnpm --filter @shaman/client start",
    "db:backup": "node tools/ops/with-env.mjs node tools/ops/db-backup.mjs",
    "db:restore": "node tools/ops/with-env.mjs node tools/ops/db-restore.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^24"
  }
}

# Project Shaman production settings (docs/ops/DEPLOYMENT.md).
# Copy to `.env` in the repository root on the server machine and fill in real values. `.env` is gitignored;
# never commit real paths, domains or secrets. `pnpm start:server` and `pnpm db:backup` read this file.

NODE_ENV=production

# --- Game server (WebSocket + /auth + /health on one port) ---
GAME_SERVER_PORT=2567
# 127.0.0.1 when a reverse proxy on the same machine terminates HTTPS (recommended); 0.0.0.0 to accept LAN traffic.
GAME_SERVER_HOST=127.0.0.1
# Web client origin(s) allowed to connect, comma-separated, exact scheme+host(+port). Required in production.
SHAMAN_ALLOWED_ORIGINS=https://play.example.com
# 1 only when a reverse proxy you control sets X-Forwarded-For (Caddy/Nginx in front). Otherwise leave 0.
SHAMAN_TRUST_PROXY=1
# Login/register attempts per IP per minute.
SHAMAN_AUTH_ATTEMPTS_PER_MINUTE=10
# Autosave period for signed-in characters (ms).
SHAMAN_AUTOSAVE_MS=10000

# --- Player database (SQLite) ---
# Required in production: a persistent location OUTSIDE the repository folder.
SHAMAN_DB_PATH=D:/shaman-data/shaman.sqlite

# --- Backups (pnpm db:backup) ---
SHAMAN_BACKUP_DIR=D:/shaman-backups
# Number of verified copies to keep (48 = two days of hourly backups).
SHAMAN_BACKUP_KEEP=48

# --- Web client (pnpm start:client serves the built Next.js app on this port) ---
PORT=3000
# Read by `next build`, so set it before building the client (also in apps/client/.env.production.local).
# The public WebSocket address of the game server through the proxy.
NEXT_PUBLIC_GAME_SERVER_URL=wss://game.example.com

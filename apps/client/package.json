{
  "name": "@shaman/client",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:network": "node scripts/network-smoke.mjs",
    "test:npc": "node scripts/npc-services-test.mjs && node scripts/npc-network-smoke.mjs",
    "test:skill": "node scripts/skill-text-test.mjs && node scripts/skill-reset-test.mjs && node scripts/skill-network-smoke.mjs && node scripts/invoke-network-smoke.mjs",
    "test:zone": "node scripts/combat-system-test.mjs && node scripts/hunter-combat-test.mjs && node scripts/rune-seer-combat-test.mjs && node scripts/japan-combat-test.mjs && node scripts/nations-combat-test.mjs && node scripts/phase5-test.mjs && node scripts/zone-network-smoke.mjs",
    "test:equipment": "node scripts/equipment-network-smoke.mjs && node scripts/persistence-network-smoke.mjs",
    "test:modular": "node scripts/modular-assets-test.mjs",
    "test:head": "node scripts/head-assets-test.mjs",
    "test:character-v2": "node scripts/character-v2-assets-test.mjs",
    "test:hair": "node ../../tools/rig/test_hair_collection.mjs && node ../../packages/shared/scripts/hair-collection-test.mjs"
  },
  "dependencies": {
    "@shaman/shared": "workspace:*",
    "@shaman/schema": "workspace:*",
    "@colyseus/sdk": "0.18.5",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "phaser": "3.90.0",
    "zustand": "^5.0.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0",
    "class-variance-authority": "^0.7.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0"
  }
}

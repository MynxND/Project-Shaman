    {
        "name":  "animate_image",
        "description":  "Animate any image from a text description of the motion.\n\nWorks on a loose sprite â unlike animate_character / animate_object, which\nneed an id of something PixelLab generated.\n\nget_image returns frame_count + 1 images: index 0 is your input frame\nunchanged, then the generated ones. Play them in order.\n\nExamples:\n- animate_image(first_frame_base64=\u003cpng\u003e, action=\"walking forward\", frame_count=8)\n- pin the ending: animate_image(first_frame_base64=\u003copen\u003e, last_frame_base64=\u003cclosed\u003e,\n                                action=\"chest lid closing\", frame_count=6)\n\nLimits: frame max 256x256, and width x height x frame_count \u003c= 524288 â so a\n256x256 frame allows 8 frames, a 64x64 frame allows all 16.\n\nCost scales with total pixels (a 64x64 8-frame animation is 1 generation, a\n128x128 16-frame one is 4). Generation time: ~30-180 seconds (async).\nPoll with get_image(job_id).",
        "inputSchema":  {
                            "additionalProperties":  false,
                            "properties":  {
                                               "action":  {
                                                              "description":  "The motion (e.g. \u0027walking forward\u0027, \u0027flame flickering\u0027, \u0027chest opening\u0027). Describe movement, not appearance.",
                                                              "maxLength":  1000,
                                                              "type":  "string"
                                                          },
                                               "frame_count":  {
                                                                   "default":  8,
                                                                   "description":  "Frames to generate â must be EVEN. 4 for idle loops, 8 for walk/run, 16 for complex actions. Large frames allow fewer frames.",
                                                                   "maximum":  16,
                                                                   "minimum":  4,
                                                                   "type":  "integer"
                                                               },
                                               "first_frame_base64":  {
                                                                          "default":  null,
                                                                          "description":  "Base64 PNG to animate â the first frame. Max 256x256. PREFER first_frame_url; MCP clients routinely truncate large inline base64.",
                                                                          "type":  [
                                                                                       "string",
                                                                                       "null"
                                                                                   ]
                                                                      },
                                               "first_frame_url":  {
                                                                       "default":  null,
                                                                       "description":  "Alternative to first_frame_base64: an https (or data:) URL to the first frame PNG. PREFER THIS. Give one, not both.",
                                                                       "type":  [
                                                                                    "string",
                                                                                    "null"
                                                                                ]
                                                                   },
                                               "last_frame_base64":  {
                                                                         "default":  null,
                                                                         "description":  "Optional final frame, same size as the first, to pin where the motion ends (interpolation instead of open-ended animation).",
                                                                         "type":  [
                                                                                      "string",
                                                                                      "null"
                                                                                  ]
                                                                     },
                                               "last_frame_url":  {
                                                                      "default":  null,
                                                                      "description":  "Alternative to last_frame_base64: an https (or data:) URL to the final frame PNG. Give one, not both.",
                                                                      "type":  [
                                                                                   "string",
                                                                                   "null"
                                                                               ]
                                                                  },
                                               "no_background":  {
                                                                     "default":  null,
                                                                     "description":  "Background handling. Default (unset) follows the first frame: a transparent sprite animates on transparency, an opaque image stays opaque.",
                                                                     "type":  [
                                                                                  "boolean",
                                                                                  "null"
                                                                              ]
                                                                 },
                                               "seed":  {
                                                            "default":  null,
                                                            "description":  "Seed for reproducible generation.",
                                                            "minimum":  0,
                                                            "type":  [
                                                                         "integer",
                                                                         "null"
                                                                     ]
                                                        },
                                               "project_id":  {
                                                                  "default":  null,
                                                                  "description":  "Internal Game Builder project context; the finished image is linked after generation.",
                                                                  "type":  [
                                                                               "string",
                                                                               "null"
                                                                           ]
                                                              }
                                           },
                            "required":  [
                                             "action"
                                         ],
                            "type":  "object"
                        },
        "annotations":  {
                            "readOnlyHint":  false,
                            "destructiveHint":  false,
                            "idempotentHint":  false,
                            "openWorldHint":  false
                        },

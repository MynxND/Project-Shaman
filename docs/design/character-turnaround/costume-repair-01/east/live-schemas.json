        "name":  "wait_for_jobs",
        "description":  "Wait for your running generations instead of sleeping and polling.\n\nReturns as soon as ANY of your pending/processing jobs finishes, immediately\nwhen none are running, or at the timeout. Free. Then call the matching get_*\ntool for the result; call wait_for_jobs again for the jobs still running.",
        "inputSchema":  {
                            "additionalProperties":  false,
                            "properties":  {

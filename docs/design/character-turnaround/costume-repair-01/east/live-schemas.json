                                                                       "default":  240,
                                                                       "description":  "Give up waiting after this many seconds (jobs keep running).",
                                                                       "maximum":  540,
                                                                       "minimum":  5,
                                                                       "type":  "integer"
                                                                   }
                                           },
                            "type":  "object"
                        },

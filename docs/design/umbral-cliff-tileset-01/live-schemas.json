    {
        "name":  "get_topdown_tileset",
        "description":  "Get a topdown Wang tileset by ID. Returns status, download links, base tile IDs for chaining, and an example map image.\n\nDownload: no auth, the UUID is the key. GET /mcp/tilesets/{id}/image for the sheet PNG (add ?inline=true to be served the bytes instead of a CDN redirect, which Python stdlib clients need), GET /mcp/tilesets/{id}/metadata for per-tile bounding_box (x/y/width/height, use as atlas regions), corners (NW/NE/SW/SE, each lower/upper/transition, use for Wang autotiling) and pattern_4x4. Both answer 423 + Retry-After while generating. Godot walkthrough: the MCP resource pixellab://docs/godot/wang-tilesets.",
        "inputSchema":  {
                            "additionalProperties":  false,
                            "properties":  {
                                               "tileset_id":  {
                                                                  "description":  "The UUID of the topdown tileset to retrieve",
                                                                  "type":  "string"
                                                              }
                                           },
                            "required":  [
                                             "tileset_id"
                                         ],
                            "type":  "object"
                        },
        "annotations":  {
                            "readOnlyHint":  true,
                            "destructiveHint":  false,
                            "idempotentHint":  true,
                            "openWorldHint":  false
                        },

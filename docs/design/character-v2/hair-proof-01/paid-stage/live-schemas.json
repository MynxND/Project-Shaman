    {
        "name":  "get_pro_flash_capabilities",
        "description":  "Get Pro Flash exact native size pairs, controls and one-image output counts.\n\nFree identity-only lookup. Supply operation, width and height together for\na provisional quote split into image/rotations/total. Finishing a selected\npreview bills only rotations; one-direction object finalization costs zero.\nLarger research sizes are not supported generation sizes. Read this before\nselecting dimensions for image, character or object creation, edit or inpaint.",
        "inputSchema":  {
                            "additionalProperties":  false,
                            "properties":  {
                                               "operation":  {
                                                                 "default":  null,
                                                                 "enum":  [
                                                                              "create",

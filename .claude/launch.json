{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "shaman-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "shaman-server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@shaman/server",
        "dev"
      ],
      "port": 2567
    },
    {
      "name": "pose-studio",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/pose-studio/server.mjs"
      ],
      "port": 8790
    },
    {
      "name": "anim-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8798",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8798
    }
  ]
}